<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_return_label" model="mail.template">
            <field name="name">Devolución Shopify: etiqueta Nacex</field>
            <field name="model_id" ref="model_shopify_return_log"/>
            <field name="email_to">${object.email}</field>
            <field name="subject">Tu devolución del pedido ${object.remarks}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>Hola ${object.partner_name or ''},</p>
    <p>Adjuntamos la etiqueta para la devolución de tu pedido <strong>${object.remarks}</strong>.</p>
    <p>Puedes entregar el paquete en cualquier punto NACEX.shop.</p>
    <p>Muchas gracias.</p>
</div>
            </field>
        </record>
    </data>
</odoo>
