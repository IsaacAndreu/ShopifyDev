<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cada 5 min: busca batches nous dins l'horari de la configuració i continua creant
             comandes (com a molt "Segundos por ejecución" cada vegada). Desactivat en instal·lar. -->
        <record id="cron_vp_dropship" model="ir.cron">
            <field name="name">Veepee DP: descargar batches y crear pedidos</field>
            <field name="model_id" ref="model_vp_dropship_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_run()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
