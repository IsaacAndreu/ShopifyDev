<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_vp_dropship_manager" model="res.groups">
        <field name="name">Dropshipping Veepee: Configuración</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_vp_dropship_batch_company" model="ir.rule">
        <field name="name">Batches Veepee: compañías permitidas</field>
        <field name="model_id" ref="model_vp_dropship_batch"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
