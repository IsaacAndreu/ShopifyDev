<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Configuració ================= -->
    <record id="view_vp_dropship_config_form" model="ir.ui.view">
        <field name="name">vp.dropship.config.form</field>
        <field name="model">vp.dropship.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Probar conexión"
                            attrs="{'invisible': [('simulate_api', '=', True)]}"/>
                    <button name="action_fetch_now" type="object" string="Buscar batches ahora" class="btn-primary"
                            attrs="{'invisible': [('simulate_api', '=', True)]}"/>
                    <button name="action_fill_carriers" type="object" string="Añadir transportistas 'Veepee - …'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="API Veepee">
                            <field name="simulate_api"/>
                            <field name="base_url" attrs="{'invisible': [('simulate_api', '=', True)]}"/>
                            <field name="api_version" attrs="{'invisible': [('simulate_api', '=', True)]}"/>
                            <field name="api_user" attrs="{'invisible': [('simulate_api', '=', True)]}"/>
                            <field name="api_password" password="True"
                                   attrs="{'invisible': [('simulate_api', '=', True)]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Automático">
                            <field name="auto_fetch"/>
                            <label for="fetch_from" string="Horario de búsqueda"/>
                            <div>
                                <field name="fetch_from" widget="float_time" class="oe_inline"/> -
                                <field name="fetch_to" widget="float_time" class="oe_inline"/>,
                                cada <field name="fetch_every" class="oe_inline"/> min
                            </div>
                            <field name="start_date"/>
                            <field name="auto_create"/>
                            <field name="max_seconds"/>
                            <field name="last_fetch"/>
                            <field name="last_error" attrs="{'invisible': [('last_error', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Datos de los pedidos">
                            <group>
                                <group>
                                    <field name="partner_id"/>
                                    <field name="partner_shipping_id"/>
                                    <field name="warehouse_id"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="order_type_id"/>
                                    <field name="season_id"/>
                                    <field name="brand_id"/>
                                </group>
                                <group>
                                    <field name="team_id"/>
                                    <field name="user_id"/>
                                    <field name="payment_mode_id"/>
                                    <field name="payment_term_id"/>
                                    <field name="delivery_days"/>
                                    <!-- Comandes a preu 0: la tarifa es posa en acabar la campanya -->
                                    <field name="use_price_file" invisible="1"/>
                                    <field name="pricelist_es_id" invisible="1"/>
                                    <field name="pricelist_fr_benelux_id" invisible="1"/>
                                    <field name="pricelist_it_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Transportistas">
                            <field name="carrier_ids">
                                <tree editable="bottom">
                                    <field name="key"/>
                                    <field name="carrier_id"/>
                                    <field name="tarifa" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Variantes y avisos">
                            <group>
                                <group string="Dropshipping Veepee Product ID">
                                    <field name="update_veepee_ids"/>
                                    <field name="veepee_field"/>
                                </group>
                                <group string="Correo si un batch tiene errores">
                                    <field name="notify_emails"/>
                                    <field name="email_from"/>
                                    <field name="mail_server_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vp_dropship_config_tree" model="ir.ui.view">
        <field name="name">vp.dropship.config.tree</field>
        <field name="model">vp.dropship.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="simulate_api"/>
                <field name="auto_fetch"/>
                <field name="auto_create"/>
                <field name="last_fetch"/>
            </tree>
        </field>
    </record>

    <record id="action_vp_dropship_config" model="ir.actions.act_window">
        <field name="name">Configuración Veepee DP</field>
        <field name="res_model">vp.dropship.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================= Batches ================= -->
    <record id="view_vp_dropship_batch_tree" model="ir.ui.view">
        <field name="name">vp.dropship.batch.tree</field>
        <field name="model">vp.dropship.batch</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'review'" decoration-muted="state in ('closed', 'cancel')">
                <field name="name"/>
                <field name="batch_date"/>
                <field name="n_orders"/>
                <field name="n_units"/>
                <field name="n_created"/>
                <field name="n_pending"/>
                <field name="n_error"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_vp_dropship_batch_form" model="ir.ui.view">
        <field name="name">vp.dropship.batch.form</field>
        <field name="model">vp.dropship.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download" type="object" string="Descargar de nuevo"
                            attrs="{'invisible': [('state', 'not in', ('new', 'review'))]}"/>
                    <button name="action_check" type="object" string="Volver a validar"
                            attrs="{'invisible': [('state', 'not in', ('downloaded', 'review'))]}"/>
                    <!-- Crea totes les pendents en segon pla (queue.job, lots encadenats) -->
                    <button name="action_create_orders" type="object" string="Crear pedidos" class="btn-primary"
                            confirm="Se crearán todos los pedidos pendientes en segundo plano, por lotes. ¿Continuar?"
                            attrs="{'invisible': ['|', ('state', 'not in', ('downloaded', 'creating', 'review')),
                                                  ('n_pending', '=', 0)]}"/>
                    <!-- Confirma en segon pla (queue.job, lots de 50) quan ja estan totes creades -->
                    <button name="action_confirm_orders" type="object" string="Confirmar pedidos" class="btn-primary"
                            confirm="Se confirmarán en segundo plano, por lotes, todos los pedidos en borrador de este batch. ¿Continuar?"
                            attrs="{'invisible': ['|', '|', ('state', 'not in', ('done', 'review')),
                                                  ('n_pending', '!=', 0), ('n_to_confirm', '=', 0)]}"/>
                    <!-- Sense botó "Cerrar batch en Veepee": a TUCTUC no es tanquen mai els batches -->
                    <field name="state" widget="statusbar" statusbar_visible="downloaded,creating,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="n_created" widget="statinfo" string="Pedidos creados"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="operation_code"/>
                            <field name="operation_ref"/>
                            <field name="batch_ref"/>
                            <field name="batch_date"/>
                            <field name="api_status"/>
                        </group>
                        <group>
                            <field name="n_orders"/>
                            <field name="n_units"/>
                            <field name="n_pending"/>
                            <field name="n_error"/>
                            <field name="n_to_confirm"/>
                            <field name="source_file" filename="source_filename"
                                   attrs="{'invisible': [('source_file', '=', False)]}"/>
                            <field name="source_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pedidos del batch">
                            <field name="order_line_ids">
                                <tree decoration-danger="state == 'error'" decoration-success="state == 'created'"
                                      decoration-muted="state == 'exists'">
                                    <field name="name"/>
                                    <field name="intitule"/>
                                    <field name="carrier_key"/>
                                    <field name="carrier_id"/>
                                    <field name="tarifa"/>
                                    <field name="n_lines"/>
                                    <field name="units"/>
                                    <field name="state"/>
                                    <field name="error"/>
                                    <field name="sale_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_vp_dropship_batch_search" model="ir.ui.view">
        <field name="name">vp.dropship.batch.search</field>
        <field name="model">vp.dropship.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="to_review" string="A revisar" domain="[('state', '=', 'review')]"/>
                <filter name="open" string="Sin cerrar" domain="[('state', 'not in', ('closed', 'cancel'))]"/>
            </search>
        </field>
    </record>

    <record id="action_vp_dropship_batch" model="ir.actions.act_window">
        <field name="name">Batches Veepee DP</field>
        <field name="res_model">vp.dropship.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <!-- ================= Preus ================= -->
    <record id="view_vp_dropship_price_tree" model="ir.ui.view">
        <field name="name">vp.dropship.price.tree</field>
        <field name="model">vp.dropship.price</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="campaign"/>
                <field name="barcode"/>
                <field name="price_es"/>
                <field name="price_fr_benelux"/>
                <field name="price_it"/>
            </tree>
        </field>
    </record>

    <record id="view_vp_dropship_price_search" model="ir.ui.view">
        <field name="name">vp.dropship.price.search</field>
        <field name="model">vp.dropship.price</field>
        <field name="arch" type="xml">
            <search>
                <field name="barcode"/>
                <field name="campaign"/>
                <group expand="0" string="Agrupar por">
                    <filter name="by_campaign" string="Campaña" context="{'group_by': 'campaign'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vp_dropship_price" model="ir.actions.act_window">
        <field name="name">Precios Veepee DP</field>
        <field name="res_model">vp.dropship.price</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- ================= Comanda de venda ================= -->
    <record id="view_order_form_vp_dropship" model="ir.ui.view">
        <field name="name">sale.order.form.vp.dropship</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="dp_batch_id" attrs="{'invisible': [('dp_batch_id', '=', False)]}" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
