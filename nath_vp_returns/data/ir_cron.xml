<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Desactivat: s'activa quan s'hagi provat «Leer pendientes ahora» -->
    <record id="cron_vp_returns" model="ir.cron">
        <field name="name">Devoluciones VP: leer pendientes de PinkConnect</field>
        <field name="model_id" ref="model_vp_return_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
