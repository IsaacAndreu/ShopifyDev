<odoo>
    <record id="group_vp_manager" model="res.groups">
        <field name="name">Devoluciones VP: configuración</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="config_company_rule" model="ir.rule">
        <field name="name">VP configuración: compañías</field>
        <field name="model_id" ref="model_vp_return_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="request_company_rule" model="ir.rule">
        <field name="name">VP solicitudes: compañías</field>
        <field name="model_id" ref="model_vp_return_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="return_company_rule" model="ir.rule">
        <field name="name">VP devoluciones: compañías</field>
        <field name="model_id" ref="model_vp_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
