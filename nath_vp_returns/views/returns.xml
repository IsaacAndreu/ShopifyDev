<odoo>
    <record id="config_tree" model="ir.ui.view">
        <field name="name">vp.return.config.tree</field><field name="model">vp.return.config</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="connection_id"/><field name="company_id"/><field name="last_read"/></tree></field>
    </record>
    <record id="config_form" model="ir.ui.view">
        <field name="name">vp.return.config.form</field><field name="model">vp.return.config</field>
        <field name="arch" type="xml">
            <form><header>
                <button name="action_fetch_pending" type="object" string="Leer pendientes ahora" class="oe_highlight"/>
                <button name="action_read" type="object" string="Leer API de una comanda"/>
                <button name="action_import_response" type="object" string="Importar última respuesta"/>
                <button name="action_import_sample" type="object" string="Importar ejemplo local"/>
            </header><sheet>
                <div class="alert alert-info">Solo lee de PinkConnect: no acepta solicitudes, no envía mensajes ni crea transporte. Crea la TT/DEV solo si «Simular TT/DEV» está desmarcado.</div>
                <group>
                    <group><field name="name"/><field name="connection_id"/><field name="company_id"/></group>
                    <group><field name="last_fetch"/><field name="last_fetch_result"/></group>
                </group>
                <group>
                    <group string="Automático"><field name="auto_fetch"/><field name="auto_create_dev"/><field name="simulate"/><field name="max_pages"/></group>
                    <group string="TT/DEV"><field name="return_location_id" options="{'no_create': True}"/><field name="return_full_order"/></group>
                </group>
                <group string="Una comanda (prueba)"><field name="order_id_filter"/><field name="last_read"/></group>
                <notebook><page string="Respuesta API"><field name="last_response"/></page>
                    <page string="Ejemplo local"><field name="sample_response" placeholder='[{"returnRequestId":"TEST-1","orderId":"123","status":"PENDING"}]'/></page>
                </notebook>
            </sheet></form>
        </field>
    </record>
    <record id="request_tree" model="ir.ui.view">
        <field name="name">vp.return.request.tree</field><field name="model">vp.return.request</field>
        <field name="arch" type="xml"><tree create="false" delete="false"><field name="request_date"/><field name="sale_id"/><field name="partner_id"/><field name="country_id"/><field name="product_id"/><field name="reason"/><field name="remote_status"/><field name="return_type" optional="hide"/><field name="remote_id" optional="hide"/><field name="simulated" optional="hide"/><field name="company_id" optional="hide"/></tree></field>
    </record>
    <record id="request_form" model="ir.ui.view">
        <field name="name">vp.return.request.form</field><field name="model">vp.return.request</field>
        <field name="arch" type="xml"><form create="false" delete="false"><header><button name="action_preview" type="object" string="Simular / previsualizar" class="oe_highlight"/></header><sheet>
            <div class="oe_title"><h1><field name="name"/></h1></div>
            <group><group><field name="sale_id"/><field name="partner_id"/><field name="country_id"/><field name="product_id"/><field name="request_date"/></group>
                <group><field name="remote_status"/><field name="config_id" readonly="1"/><field name="company_id"/><field name="remote_id"/><field name="order_id"/><field name="simulated"/></group></group>
            <group string="Datos de la solicitud"><field name="order_line_id"/><field name="marketplace_return_id"/><field name="marketplace_order_number"/><field name="sku"/><field name="gtin"/><field name="return_type"/><field name="reason"/></group>
            <notebook><page string="Previsualización"><field name="preview"/></page><page string="Datos originales"><field name="payload"/></page></notebook>
        </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div></form></field>
    </record>
    <record id="config_action" model="ir.actions.act_window"><field name="name">Configuración VP</field><field name="res_model">vp.return.config</field><field name="view_mode">tree,form</field></record>
    <record id="request_action" model="ir.actions.act_window"><field name="name">Artículos VP</field><field name="res_model">vp.return.request</field><field name="view_mode">tree,form</field></record>

    <record id="return_tree" model="ir.ui.view">
        <field name="name">vp.return.tree</field><field name="model">vp.return</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-danger="state == 'review'" decoration-muted="state == 'cancel'" decoration-success="state == 'dev_created'">
                <field name="request_date"/><field name="sale_id"/><field name="partner_id"/><field name="country_id"/>
                <field name="n_items"/><field name="remote_status"/><field name="dev_picking_id"/><field name="dev_state" optional="show"/>
                <field name="state"/><field name="error_msg" optional="show"/><field name="order_id" optional="hide"/><field name="company_id" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="return_form" model="ir.ui.view">
        <field name="name">vp.return.form</field><field name="model">vp.return</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_process" type="object" string="Crear TT/DEV" class="oe_highlight" states="pending,validated"/>
                    <button name="action_validate" type="object" string="Volver a validar" states="pending,validated,review"/>
                    <button name="action_reset" type="object" string="Reintentar" states="review,cancel"/>
                    <button name="action_cancel" type="object" string="Cancelar" states="pending,validated,review"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,validated,dev_created"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-danger" role="alert" attrs="{'invisible': [('error_msg', '=', False)]}"><field name="error_msg"/></div>
                    <group>
                        <group><field name="sale_id"/><field name="partner_id"/><field name="country_id"/><field name="request_date"/></group>
                        <group><field name="remote_status"/><field name="out_picking_ids" widget="many2many_tags"/><field name="dev_picking_id"/><field name="dev_state"/><field name="order_id"/><field name="config_id"/></group>
                    </group>
                    <notebook>
                        <page string="Artículos">
                            <field name="request_ids">
                                <tree><field name="product_id"/><field name="quantity"/><field name="reason"/><field name="remote_status"/><field name="return_type" optional="hide"/><field name="remote_id" optional="hide"/></tree>
                            </field>
                        </page>
                        <page string="Previsualización"><field name="preview"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="return_search" model="ir.ui.view">
        <field name="name">vp.return.search</field><field name="model">vp.return</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="sale_id"/><field name="partner_id"/><field name="dev_picking_id"/><field name="order_id"/>
                <filter name="todo" string="Por hacer" domain="[('state', 'in', ('pending', 'validated', 'review'))]"/>
                <filter name="review" string="Revisar" domain="[('state', '=', 'review')]"/>
                <filter name="with_dev" string="Con TT/DEV" domain="[('state', '=', 'dev_created')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="g_country" string="País" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="return_action" model="ir.actions.act_window">
        <field name="name">Devoluciones VP</field><field name="res_model">vp.return</field><field name="view_mode">tree,form</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>
    <!-- Menú comú per a totes les devolucions online. El mòdul Shopify es
         reubica aquí i aquest pilot hi afegeix la branca VP. -->
    <menuitem id="menu_returns_root" name="Devoluciones Online" parent="stock.menu_stock_root" sequence="25"/>
    <record id="nath_shopify_returns.menu_shopify_returns_root" model="ir.ui.menu"><field name="name">Shopify</field><field name="parent_id" ref="menu_returns_root"/></record>
    <menuitem id="menu_vp" name="VP / PinkConnect" parent="menu_returns_root" sequence="20"/>
    <menuitem id="menu_returns" name="Devoluciones" parent="menu_vp" action="return_action" sequence="5"/>
    <menuitem id="menu_requests" name="Artículos" parent="menu_vp" action="request_action" sequence="10"/>
    <menuitem id="menu_config" name="Configuración" parent="menu_vp" action="config_action" sequence="20" groups="group_vp_manager"/>
</odoo>
