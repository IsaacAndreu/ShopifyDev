<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ir_category_pink_connect" model="ir.module.category">
            <field name="name">PinkConnect</field>
        </record>

        <record id="group_pink_connect_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="ir_category_pink_connect"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_pink_connect_admin" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="ir_category_pink_connect"/>
            <field name="implied_ids" eval="[(4, ref('group_pink_connect_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>