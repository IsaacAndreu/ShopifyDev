<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>
		<record id="view_order_form_pink_connect_inherit" model="ir.ui.view">
			<field name="name">pink.connect.sale.order</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form"/>
			<field name="arch" type="xml">
				<xpath expr="//notebook" position="inside">
					<page name="Pink Connect" string="Pink Connect">
						<group name="mapping" string="Mappings">
							<field name="pink_connect_mapping_id" readonly="1" nolabel="1"/>
						</group>
					</page>
				</xpath>
			</field>
		</record>
	</data>
</odoo>
