<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cada mañana. Solo envía si la configuración tiene destinatarios en "Resumen diario a". -->
        <record id="ir_cron_shopify_returns_summary" model="ir.cron">
            <field name="name">Devoluciones Shopify: resumen diario</field>
            <field name="model_id" ref="model_shopify_return_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_daily_summary()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:45:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
