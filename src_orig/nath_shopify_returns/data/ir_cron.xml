<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Desactivado por defecto: activarlo cuando la prueba manual esté OK -->
        <record id="ir_cron_shopify_returns" model="ir.cron">
            <field name="name">Devoluciones Shopify: leer y procesar</field>
            <field name="model_id" ref="model_shopify_return_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_returns()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
